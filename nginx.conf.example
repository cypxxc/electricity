# ==============================================================================
# Nginx Reverse Proxy Configuration Example for HTTPS & Next.js
# ==============================================================================
server {
    listen 80;
    server_name electricity.health7.moph.go.th; # เปลี่ยนเป็นโดเมนจริงของคุณ

    # บังคับ Redirect ไปยัง HTTPS
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl http2;
    server_name electricity.health7.moph.go.th; # เปลี่ยนเป็นโดเมนจริงของคุณ

    # เส้นทางไฟล์ SSL/TLS Certificates
    ssl_certificate /etc/letsencrypt/live/electricity.health7.moph.go.th/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/electricity.health7.moph.go.th/privkey.pem;

    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_ciphers HIGH:!aNULL:!MD5;
    ssl_prefer_server_ciphers on;

    # ขนาดไฟล์อัปโหลดสูงสุดสำหรับ Import (15MB)
    client_max_body_size 15M;

    location / {
        proxy_pass http://127.0.0.1:3000;
        proxy_http_version 1.1;

        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection 'upgrade';
        proxy_set_header Host $host;
        proxy_cache_bypass $http_upgrade;

        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        # Timeouts สำหรับงานประมวลผลไฟล์ขนาดใหญ่
        proxy_connect_timeout 60s;
        proxy_send_timeout 60s;
        proxy_read_timeout 60s;
    }
}
