# ==============================================================================
# Environment Configuration Template
# คัดลอกไฟล์นี้เป็น .env ก่อนเริ่มรันระบบ (cp .env.example .env)
# ==============================================================================

# Database Connection (PostgreSQL)
# ------------------------------------------------------------------------------
# เมื่อรันผ่าน Docker Compose (เชื่อมต่อผ่าน Network ภายใน):
DATABASE_URL=postgresql://postgres:postgrespassword@postgres:5432/electricity_db
# เมื่อรันแบบ Local Development (รันแอปนอก Docker แต่ต่อ Postgres บน localhost):
# DATABASE_URL=postgresql://postgres:postgrespassword@localhost:5432/electricity_db

# Security & Session Authentication
# ------------------------------------------------------------------------------
# คีย์สำหรับลงนามและตรวจสอบสิทธิ์ Session Token (JWT)
# *คำแนะนำสำคัญ*: เมื่อนำขึ้น Production ให้สร้างคีย์สุ่มยาวอย่างน้อย 32 ตัวอักษร
# ตัวอย่างการสร้าง: openssl rand -base64 32
JWT_SECRET=super-secret-jwt-key-min-32-chars-long-12345

# Initial Admin Account (บัญชีผู้ดูแลระบบตั้งต้น)
# ------------------------------------------------------------------------------
ADMIN_USERNAME=admin
ADMIN_PASSWORD=adminpassword123
